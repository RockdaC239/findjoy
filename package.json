{
  "name": "findjoy-life-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "一款由 AI 驱动的人生模拟游戏：在选择中回望一生，不提供统一的幸福或成功分数。",
  "license": "MIT",
  "author": "FindJoy contributors",
  "homepage": "https://github.com/RockdaC239/findjoy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockdaC239/findjoy.git"
  },
  "bugs": {
    "url": "https://github.com/RockdaC239/findjoy/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "life-simulator",
    "nextjs",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "db:preflight": "node scripts/preflight-deploy.mjs",
    "points:adjust": "node scripts/adjust-points.mjs",
    "load:seed": "node scripts/load-test-seed.mjs",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.3",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
