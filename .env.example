# Online deployments use environment mode by default in production. Local development
# uses the settings panel and stores the selected key/model in .data/model-config.json.
# Online deployments can set this explicitly. Leave it unset for local development.
# FINDJOY_MODEL_CONFIG_MODE=environment
# Optional custom path for local model-config.json storage.
# FINDJOY_MODEL_CONFIG_PATH=

# Any provider exposing the OpenAI-compatible /chat/completions endpoint works.
# Examples: OpenAI, Azure OpenAI gateway, OpenRouter, Together, Groq, DeepSeek.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: enables response-level estimated USD cost from provider pricing.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Legacy SQLite path is used only by the forthcoming data import command.
# Application stores require DATABASE_URL; there is no SQLite fallback.

# Authentication (OIDC authorization code + PKCE). Public application: token auth=none, RS256.
FINDJOY_APP_ORIGIN=http://localhost:3000
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
# Optional for confidential applications configured with client_secret_post.
AUTHING_CLIENT_SECRET=

# One-time signup points gift; set 0 to disable. New configuration does not regrant old users.
FINDJOY_TRIAL_CREDITS=100

# Demo is the default. No real charge or paid credits in demo mode.
FINDJOY_PAYMENTS_MODE=demo
# Required only in live mode: JSON array of {id,name,credits,amountFen} approved products.
# FINDJOY_PRODUCTS_JSON=
# Copy API base URL from Xiaodou credentials; never guess a gateway host.
XIAODOU_BASE_URL=
XIAODOU_APP_ID=
XIAODOU_KEY_ID=
# Absolute server paths, outside the deployed source directory; never commit private keys.
XIAODOU_PRIVATE_KEY_FILE=
# JSON mapping platform kid to pinned public PEM; verify fingerprint against official docs.
XIAODOU_PLATFORM_KEYS_FILE=
# Comma-separated HTTPS origins of the actual platform cashier, confirmed before live mode.
XIAODOU_CASHIER_ORIGINS=
# Optional scheduler authentication, at least 32 random characters. Do not put it in URLs.
FINDJOY_RECONCILE_TOKEN=

# Local real-payment testing only: your public payer IP, ignored outside loopback development.
# FINDJOY_DEV_PAYER_IP=

# PostgreSQL: required for all identity, game, payment and rate-limit stores.
# Server-only connection string; use a dedicated restricted role, never NEXT_PUBLIC_.
# DATABASE_URL=
# Maximum connections per application process (1–20); reserve server capacity for FindFire.
# FINDJOY_DB_POOL_MAX=5
# Isolated integration tests only; never point this at a production database.
# TEST_DATABASE_URL=

# Offline SQLite import only; absolute path to a verified final backup, never runtime fallback.
# SQLITE_IMPORT_PATH=
# Set only after verifying every source writer is stopped; not a substitute for that check.
# FINDJOY_IMPORT_WRITES_FROZEN=yes

# Model admission limits shared across processes via PostgreSQL. Tune only after load testing.
FINDJOY_GENERATION_MAX_CONCURRENT=4
# false pauses NEW generation; existing work and saved-life recovery continue.
FINDJOY_GENERATION_ENABLED=true
